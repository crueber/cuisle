              "type": "text",
              "text": "Admin › Ingredients",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Volume ↔ weight only converts when the ingredient has a density; otherwise the original unit stays."
            }
