    {
      "type": "rule"
    },
    {
      "type": "codeBlock",
      "attrs": {
        "language": "kotlin"
      },
      "content": [
        {
          "type": "text",
          "text": "fun convert(amount: Double, from: Unit, to: Unit, density: Double?): Double =\n    if (from.kind == to.kind) amount * from.factor / to.factor\n    else density?.let { amount * from.factor * it / to.factor } ?: amount"
        }
      ]
    },
    {
      "type": "decisionList",
      "attrs": {
        "localId": "0"
      },
      "content": [
        {
          "type": "decisionItem",
          "attrs": {
            "state": "DECIDED",
            "localId": "1"
          },
          "content": [
            {
              "type": "text",
              "text": "Store the user's preference server-side, not per device"
            }
          ]
        }
      ]
    },
    {
      "type": "expand",
      "attrs": {
        "title": "Density coverage",
        "collapsed": true
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Measured on 1,200 recipes: 94% have a density for every ingredient; "
            },
            {
              "type": "text",
              "text": "6%",
              "marks": [
                {
                  "type": "textColor",
                  "attrs": {
                    "color": "#bf2600"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " fall back to the original unit."
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Run "
            },
            {
              "type": "text",
              "text": "./gradlew :recipes:densityReport",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " to regenerate."
