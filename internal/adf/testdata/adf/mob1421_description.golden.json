    {
      "t": "code",
      "x": "fun convert(amount: Double, from: Unit, to: Unit, density: Double?): Double =\n    if (from.kind == to.kind) amount * from.factor / to.factor\n    else density?.let { amount * from.factor * it / to.factor } ?: amount",
      "a": {
        "lang": "kotlin"
      }
