{
  "name": "cuisle-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "tokens": "node scripts/tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "build:dev": "vite build --minify false --mode development"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "@wailsio/runtime": "3.1.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@size-limit/file": "14.3.0",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "size-limit": "14.3.0",
    "terser": "5.51.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
